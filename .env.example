# ============================================================================
# FANTASY COACH — environment configuration
# Copy to .env.local (Next.js) or .env (scripts) and fill in. NEVER commit .env*
# ============================================================================

# ---------------------------------------------------------------------------
# DATABASE (required for ingestion + persistence; Draft Mode works without it)
# ---------------------------------------------------------------------------
# Local dev:  postgres://root@localhost:5432/fantasy_coach
# Supabase:   postgres://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgres://root@localhost:5432/fantasy_coach

# ---------------------------------------------------------------------------
# AI (optional — the deterministic engine runs fine without it; the LLM only
# narrates. With no key set, Coach falls back to template explanations.)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Model used for conversational reasoning / explanation
COACH_MODEL=claude-sonnet-5
# Cheaper model used for bulk news classification
COACH_CLASSIFIER_MODEL=claude-haiku-4-5-20251001
# Hard ceiling on AI spend per rolling 24h, in USD. 0 disables the LLM layer.
COACH_DAILY_AI_BUDGET_USD=2.00

# ---------------------------------------------------------------------------
# LEAGUE PLATFORM INTEGRATION
# ---------------------------------------------------------------------------
# Sleeper: fully public read-only API, NO key required. Just your user/league id.
SLEEPER_USERNAME=
SLEEPER_LEAGUE_ID=
SLEEPER_DRAFT_ID=

# ESPN Fantasy: private leagues require cookies copied from a logged-in browser
# session (espn.com -> DevTools -> Application -> Cookies). Public leagues need
# neither. These expire; re-copy when sync starts failing.
ESPN_LEAGUE_ID=
ESPN_S2=
ESPN_SWID=

# Yahoo Fantasy: OAuth2. Register an app at developer.yahoo.com/apps/create/
# (Fantasy Sports -> Read). Redirect URI must match exactly.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:3000/api/auth/yahoo/callback

# ---------------------------------------------------------------------------
# OPTIONAL PAID / KEYED DATA SOURCES
# Everything works without these; they raise data quality if you have them.
# ---------------------------------------------------------------------------
# FantasyPros API (consensus rankings + ADP). Paid tier: fantasypros.com/api/
FANTASYPROS_API_KEY=
# SportsDataIO (injuries, projections, depth charts). sportsdata.io
SPORTSDATAIO_API_KEY=
# The Odds API (Vegas totals for start/sit). the-odds-api.com — free tier exists
ODDS_API_KEY=
# OpenWeather (game-day weather). openweathermap.org — free tier exists
OPENWEATHER_API_KEY=

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
# Shared-secret guard for /api/admin/* and cron ingestion endpoints.
ADMIN_TOKEN=
# Set to 1 to allow outbound network fetches from ingestion adapters.
# Leave 0 in sandboxes with blocked egress so ingestion fails fast + loud.
INGEST_NETWORK_ENABLED=1
